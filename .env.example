# Full chat-completions URL. Do not use a campus-only key with another provider.
LLM_API_URL=https://genai.comp.polyu.edu.hk/api/v1/chat/completions
LLM_MODEL=DeepSeek-V4-Flash
LLM_API_KEY=
# prompt works with the campus API; json_object may be enabled for compatible providers.
LLM_JSON_MODE=prompt

# For Vercel, configure a publicly reachable provider with its OWN key, for example:
# LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_MODEL=your-chosen-openrouter-model-id

# Leave empty for local SQLite. Required on Vercel. Use Neon's pooled connection.
DATABASE_URL=
# Direct Neon connection for the explicit init-db command, when needed.
DATABASE_INIT_URL=
SECRET_KEY=
FLASK_DEBUG=0
